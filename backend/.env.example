# CarePulse backend configuration — copy to .env and fill in real values.

DATABASE_URL=sqlite:///./carepulse.db
# For PostgreSQL: postgresql+psycopg://user:xxxxx@host:5432/carepulse

JWT_SECRET_KEY=xxxxx
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini — powers every AI feature (remarks, copilot, intake,
# panel insights, care plans). Get a key at https://aistudio.google.com
GEMINI_API_KEY=xxxxx
GEMINI_MODEL=gemini-3-flash-preview

CORS_ORIGINS=http://localhost:8000,http://localhost:5173
